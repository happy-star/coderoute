# Copy to .env and fill in a workspace token from https://otari.ai (API Keys).
# The token starts with otk_ and is shown only once. Never commit .env.

# Workspace API token. Leave empty to run the UI in mock mode.
OTARI_API_KEY=

# Hosted gateway. OpenAI-compatible clients use this as base_url.
# Confirmed against docs.otari.ai quickstart and the live gateway (0.38.0).
# EU workspaces: https://eu.api.otari.ai/api/v1
# (api.otari.ai answers an EU key with 421 and names that host.)
# Self-hosted: http://localhost:8000/api/v1
OTARI_BASE_URL=https://api.otari.ai/api/v1

# How the key is sent.
# bearer    — Authorization: Bearer, as the hosted quickstart shows.
# otari-key — Otari-Key header, the OpenAPI security scheme (ApiKeyAuth).
# The live gateway accepts both. An invalid key returns {"detail":"Invalid API key"}.
OTARI_AUTH=bearer

# Catalog model ids (Models tab, or GET /api/v1/models). openai/gpt-oss-20b is an
# open-weight catalog id. "auto" picks the cheapest other chat model for the review pass.
OTARI_CODER_MODEL=openai/gpt-oss-20b
OTARI_REVIEW_MODEL=auto
OTARI_REVIEW_FALLBACK=openai/gpt-oss-safeguard-20b

# Hosted dashboard (Activity is the Requests log; /activity redirects to /requests).
# Self-hosted dashboard is the gateway origin, for example http://localhost:8000
OTARI_DASHBOARD_URL=https://otari.ai/dashboard

# Set to 1 to force mock mode even when a key is present.
OTARI_MOCK=0
